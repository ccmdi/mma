#!/bin/sh

[ "$HUSKY" = "0" ] && exit 0

git_dir=$(git rev-parse --git-dir)
[ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ] || [ -f "$git_dir/CHERRY_PICK_HEAD" ] && exit 0

cd app

# Format + lint staged files
npx lint-staged || exit 1

# Format staged Rust files
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs' | grep '^app/src-tauri/src/')
if [ -n "$STAGED_RS" ]; then
	(cd .. && rustfmt --check --edition 2021 $STAGED_RS) >/dev/null 2>&1 ||
		echo "[pre-commit] rustfmt would reformat a staged Rust file (advisory)."
fi

# TypeScript type check
echo "[pre-commit] TypeScript..."
npx tsc --noEmit -p tsconfig.app.json || exit 1

echo "[pre-commit] All checks passed."
