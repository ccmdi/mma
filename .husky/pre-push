#!/bin/sh

[ "$HUSKY" = "0" ] && exit 0

repo=$(git rev-parse --show-toplevel)

release_tag=0
while read -r local_ref local_sha remote_ref remote_sha; do
	case "$remote_ref" in
		refs/tags/v[0-9]*) release_tag=1 ;;
	esac
done

echo "[pre-push] running the CI gates..."
sh "$repo/scripts/gates.sh" || {
	echo "[pre-push] gates failed; push refused."
	exit 1
}

if [ "$release_tag" = 1 ]; then
	echo "[pre-push] release tag: running the e2e suite (Docker)..."
	bash "$repo/scripts/e2e.sh" --mock --shard 3 || {
		echo "[pre-push] e2e failed; release push refused."
		exit 1
	}
fi
